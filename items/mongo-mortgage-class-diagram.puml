@startuml
title MongoDB Class Diagram — Mortgage Deal Management Service

skinparam classAttributeIconSize 0
skinparam linetype ortho

class MortgageDealDocument <<collection>> {
_id: String
dealNumber: String
applicationDate: DateTime
status: String
requestedAmount: Decimal
termMonths: Integer
updatedAt: DateTime [0..1]

client: ClientSnapshot
properties: MortgageDealPropertySnapshot[]
bankEmployee: BankEmployeeSnapshot
loanAgreement: LoanAgreement [0..1]
}

class ClientSnapshot {
clientId: UUID
lastName: String
firstName: String
middleName: String [0..1]
passport: String
phone: String
email: String
birthDate: Date
monthlyIncome: Decimal
incomeProofType: String
}

class MortgageDealPropertySnapshot {
pledgeStatus: String
pledgeValue: Decimal
pledgeStartDate: Date [0..1]
pledgeEndDate: Date [0..1]
updatedAt: DateTime [0..1]

property: PropertySnapshot
}

class PropertySnapshot {
propertyId: UUID
address: String
cadastralNumber: String
appraisedValue: Decimal

propertyType: PropertyTypeSnapshot
}

class PropertyTypeSnapshot {
propertyTypeId: UUID
name: String
}

class BankEmployeeSnapshot {
employeeId: UUID
fullName: String
position: String
internalCode: String
}

class LoanAgreement {
agreementNumber: String
agreementDate: Date
endDate: Date
interestRate: Decimal
loanAmount: Decimal
monthlyPayment: Decimal
updatedAt: DateTime [0..1]
}

MortgageDealDocument *-- "1" ClientSnapshot : client
MortgageDealDocument *-- "1..*" MortgageDealPropertySnapshot : properties
MortgageDealDocument *-- "1" BankEmployeeSnapshot : bankEmployee
MortgageDealDocument *-- "0..1" LoanAgreement : loanAgreement

MortgageDealPropertySnapshot *-- "1" PropertySnapshot : property
PropertySnapshot *-- "1" PropertyTypeSnapshot : propertyType

@enduml
